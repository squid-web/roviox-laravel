{
    "name": "squidweb/roviox-laravel",
    "description": "Laravel SDK for the Roviox API: transactional email, support tickets and newsletter campaigns.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "roviox",
        "mail",
        "transactional",
        "newsletter",
        "laravel"
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Roviox\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Roviox\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Roviox\\RovioxServiceProvider"
            ],
            "aliases": {
                "Roviox": "Roviox\\Facades\\Roviox"
            }
        }
    },
    "minimum-stability": "stable"
}
